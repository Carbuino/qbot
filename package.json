{
  "name": "qbot",
  "version": "7.5.0",
  "description": "The most advanced Discord to Roblox ranking bot available, open source and free, without any branding.",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "prestart": "prisma migrate deploy --schema=src/database/schema.prisma",
    "start": "tsx src/main.ts",
    "build": "tsc --outDir dist",
    "dev": "nodemon src/main.ts --ignore ./src/resources/commands.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "resetSlashCmds": "echo [] > src/resources/commands.json",
    "update": "git fetch && git reset --hard origin/master && git pull",
    "postinstall": "prisma generate --schema=src/database/schema.prisma"
  },
  "author": "LengoLabs",
  "license": "MIT",
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "axios": "^1.17.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "figlet": "^1.11.0",
    "got": "^15.0.5",
    "lexure": "^0.17.0",
    "lodash": "^4.18.1",
    "ms": "^2.1.3",
    "noblox.js": "^9.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.0": true,
    "noblox.js@9.0.0": true,
    "prisma@6.19.3": true
  }
}
